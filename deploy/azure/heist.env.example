# Private production config: install as /etc/heist/heist.env (root-owned, 0600).
# No ngrok token and no frontend-specific environment variables are required.
DATABASE_BACKEND=mongodb
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?appName=TheHeist
MONGODB_DATABASE=heist_zero_hour
NODE_ENV=production
DEBUG_ENDPOINTS=false
HOST=127.0.0.1
PORT=8080
ALLOW_REGISTER=true
MAX_PLAYERS=60
EVENT_DURATION_MINUTES=180
LOG_LEVEL=info
TICK_RATE=20
STEP_TICKS=5
CHUNK_SIZE=16
MAX_PENDING_MOVES=2
MSG_RATE_PER_SEC=60
MSG_BURST=100
HEARTBEAT_TIMEOUT_MS=15000
GHOST_GRACE_MS=30000
SNAPSHOT_INTERVAL_MS=10000
BACKPRESSURE_BYTES=256000
UV_THREADPOOL_SIZE=4
