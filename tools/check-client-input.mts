import { strict as assert } from 'node:assert';
import { DIR } from '@heist/shared';
import { KeyboardInputHandler } from '../apps/client/src/engine/input.js';
const listeners=new Map<string,((event:any)=>void)[]>();
const on=(name:string,handler:(event:any)=>void)=>listeners.set(name,[...(listeners.get(name)||[]),handler]);
Object.assign(globalThis,{window:{addEventListener:on},document:{addEventListener:on,hidden:false},HTMLInputElement:class{},HTMLTextAreaElement:class{},HTMLSelectElement:class{}});
const input=new KeyboardInputHandler();
const key=(type:string,code:string)=>{for(const handler of listeners.get(type)||[])handler({code,target:null,preventDefault(){}});};
key('keydown','ArrowRight');assert.equal(input.getActiveDirection(),null,'No movement before WELCOME');
input.enable();key('keydown','ArrowRight');key('keyup','ArrowRight');
assert.equal(input.getActiveDirection(),DIR.RIGHT,'Quick tap is retained until simulation reads it');
assert.equal(input.getActiveDirection(),null,'Tap is consumed once');
key('keydown','ArrowUp');key('keydown','ArrowLeft');
assert.equal(input.getActiveDirection(),DIR.LEFT,'Most recent held direction wins');
key('keyup','ArrowLeft');assert.equal(input.getActiveDirection(),DIR.UP,'Previous held direction remains');
input.disable();assert.equal(input.getActiveDirection(),null);input.enable();assert.equal(input.getActiveDirection(),null,'Paused/reconnected inputs do not stick');
input.disable();input.setTouchDirection(DIR.RIGHT);assert.equal(input.getActiveDirection(),null,'Touch obeys the WELCOME/pause gate');
input.enable();input.setTouchDirection(DIR.LEFT);input.setTouchDirection(null);assert.equal(input.getActiveDirection(),DIR.LEFT,'Quick touch tap is retained');assert.equal(input.getActiveDirection(),null,'Touch tap is consumed once');
input.setTouchDirection(DIR.UP);assert.equal(input.getActiveDirection(),DIR.UP);assert.equal(input.getActiveDirection(),DIR.UP,'Held touch persists across frames');input.disable();input.enable();assert.equal(input.getActiveDirection(),null,'Touch is cleared on pause');
console.log('Client input checks passed: WELCOME gate, quick taps, held keyboard/touch priority and reset.');
