# Server-local SQLite. Render Free intentionally resets this file when its instance is replaced.
DATABASE_BACKEND=sqlite
DB_URL=sqlite:./data/heist.db
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DEBUG_ENDPOINTS=false
MAX_PLAYERS=60
# Trusted local CLI: tools/provision-admins.mts --create-four-staff-accounts
# Optional first-boot owner account (use secrets, never commit real credentials).
# Useful on Render Free, where an interactive shell is unavailable.
# HEIST_ADMIN_USERNAME=heist_owner
# HEIST_ADMIN_PASSWORD=
